// UcomPos - Database Schema
// Generated with Prisma ORM, targeting Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

// Connection URLs are configured in prisma.config.ts (Prisma 7+).
datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  name         String
  role         Role     @default(STAFF)
  permissions  String[] @default([])
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales              Sale[]
  services           Service[]
  installments       Installment[]
  installmentPayments InstallmentPayment[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]

  @@index([username])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
// PRODUCTS & INVENTORY
// ============================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([order])
}

model Product {
  id          Int      @id @default(autoincrement())
  productId   String   @unique
  name        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String?
  qty         Int      @default(0)
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isFavorite  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems    SaleItem[]
  installments Installment[]

  @@index([productId])
  @@index([categoryId])
  @@index([isFavorite])
  @@index([isActive])
}

// ============================================================
// SALES & TRANSACTIONS
// ============================================================

enum PaymentMethod {
  CASH
  TRANSFER
}

model Sale {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @default(now())
  itemDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  billDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  cost          Decimal       @default(0) @db.Decimal(12, 2)
  profit        Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  voided        Boolean       @default(false)
  voidedAt      DateTime?
  voidedBy      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items SaleItem[]

  @@index([userId])
  @@index([date])
  @@index([paymentMethod])
  @@index([voided])
}

model SaleItem {
  id           Int      @id @default(autoincrement())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productCode  String?
  qty          Int
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  price        Decimal  @db.Decimal(12, 2)
  itemDiscount Decimal  @default(0) @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

// ============================================================
// SERVICES (REPAIRS, TOPUPS, EXTENSIONS)
// ============================================================

enum ServiceType {
  REPAIR
  TOPUP
  EXTENSION
}

enum ServiceStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Service {
  id          String        @id @default(uuid())
  type        ServiceType
  name        String
  description String?
  cost        Decimal       @default(0) @db.Decimal(12, 2)
  price       Decimal       @default(0) @db.Decimal(12, 2)
  date        DateTime      @default(now())
  status      ServiceStatus @default(PENDING)
  details     Json?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([date])
  @@index([userId])
}

// ============================================================
// INSTALLMENTS
// ============================================================

enum InstallmentMode {
  CONSIGNMENT   // ฝากผ่อน — รอรับคอมมิชชันจากร้านส่ง
  SELF_MANAGED  // ผ่อนเอง — ร้านรับชำระค่างวดเอง
}

enum InstallmentStatus {
  PENDING_COMMISSION   // CONSIGNMENT: รอรับคอมมิชชัน
  ACTIVE               // SELF_MANAGED: กำลังผ่อน
  COMPLETED            // จบดิลแล้ว
  CANCELLED
}

enum InstallmentPaymentType {
  COMMISSION    // CONSIGNMENT: เงินคอมมิชชันจากร้านส่ง
  INSTALLMENT   // SELF_MANAGED: ค่างวดจากลูกค้า
}

model Installment {
  id              String            @id @default(uuid())
  mode            InstallmentMode
  status          InstallmentStatus @default(ACTIVE)

  productId       Int?
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSnapshot Json

  customerName    String
  customerPhone   String?
  customerNote    String?

  cost            Decimal  @default(0) @db.Decimal(12, 2)
  basePrice       Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  commission      Decimal  @default(0) @db.Decimal(12, 2)

  date            DateTime  @default(now())
  closedAt        DateTime?
  notes           String?
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payments        InstallmentPayment[]

  @@index([mode])
  @@index([status])
  @@index([date])
  @@index([userId])
  @@index([customerPhone])
}

model InstallmentPayment {
  id               String                 @id @default(uuid())
  installmentId    String
  installment      Installment            @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  type             InstallmentPaymentType
  amount           Decimal                @db.Decimal(12, 2)
  profitRecognized Decimal                @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod          @default(CASH)
  date             DateTime               @default(now())
  notes            String?
  userId           String
  user             User                   @relation(fields: [userId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([installmentId])
  @@index([date])
  @@index([type])
  @@index([paymentMethod])
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
}

// ============================================================
// DAILY CLOSE & EXPENSES
// ============================================================

model DailyClose {
  id            String   @id @default(uuid())
  date          DateTime @unique @db.Date
  cashSales     Decimal  @default(0) @db.Decimal(12, 2)
  transferSales Decimal  @default(0) @db.Decimal(12, 2)
  totalExpenses Decimal  @default(0) @db.Decimal(12, 2)
  profit        Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  pdfUrl        String?
  closedById    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]

  @@index([date])
}

model Expense {
  id           String     @id @default(uuid())
  dailyCloseId String?
  dailyClose   DailyClose? @relation(fields: [dailyCloseId], references: [id], onDelete: SetNull)
  name         String
  amount       Decimal    @db.Decimal(12, 2)
  category     String?
  date         DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([dailyCloseId])
  @@index([date])
}
