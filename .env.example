# ─────────────────────────────────────────────────────────────────────────────
# UcomPos — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Runtime connection — use the pooled port (6543) with pgBouncer for Next.js.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# Migration connection — direct port (5432), bypasses pgBouncer.
# Used by Prisma CLI (prisma migrate, prisma db push, seed).
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase (optional — only needed for Supabase Storage / Realtime) ─────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -base64 48
JWT_SECRET="change-me-min-32-chars-use-openssl-rand-base64-48"
JWT_REFRESH_SECRET="change-me-different-from-above-also-min-32-chars"

# Token lifetimes (jose time strings: Xs / Xm / Xh / Xd)
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="UcomPos"
NEXT_PUBLIC_APP_VERSION="2.0.0"

# Canonical public URL — set this on Vercel (e.g. https://ucompos.vercel.app)
# Leave blank for local dev; Next.js infers it automatically.
NEXT_PUBLIC_APP_URL=""
